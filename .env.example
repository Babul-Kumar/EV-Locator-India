# EV CHARGING STATION LOCATOR – INDIA
# Environment Variables Configuration

# Supabase Credentials
# Find these in your Supabase project dashboard under Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Google Maps API Key
# Enabled APIs: Maps JavaScript API, Places API (optional)
# Get your key at: https://console.cloud.google.com/google/maps-apis
VITE_GOOGLE_MAPS_API_KEY=
